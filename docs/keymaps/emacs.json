// Emacs Org mode keys for Kalem (design §7.3), as a user keymap: copy
// this file to keymap.json in the settings directory (on top of the Word-like
// profile). The first entries take the chords Emacs uses away from Word-like
// commands (Ctrl+C and Ctrl+X become prefixes, as in Emacs). Later bindings win
// where several apply, so list bindings come after headline ones and table
// bindings last (a table can be inside a list item).
[
  {"keys": "ctrl+s", "command": "-app.save"},
  {"keys": "ctrl+c", "command": "-edit.copy"},
  {"keys": "ctrl+x", "command": "-edit.cut"},
  // The file manager keeps Dired's keys: no Ctrl+C, Ctrl+X, Ctrl+V,
  // Ctrl+A, Ctrl+N or Space of other file managers there.
  {"keys": "ctrl+c", "command": "-dired.copyFiles"},
  {"keys": "ctrl+x", "command": "-dired.cutFiles"},
  {"keys": "ctrl+v", "command": "-dired.paste"},
  {"keys": "ctrl+a", "command": "-dired.markAll"},
  {"keys": "ctrl+n", "command": "-dired.newFile"},
  {"keys": "space", "command": "-dired.togglePreview"},
  {"keys": "ctrl+n", "command": "-file.new"},
  {"keys": "ctrl+p", "command": "-project.findFile"},
  {"keys": "ctrl+o", "command": "-file.open"},
  {"keys": "ctrl+w", "command": "-file.close"},
  {"keys": "enter", "command": "-edit.enter"},
  {"keys": "ctrl+/", "command": "-view.toggleSource"},
  {"keys": "ctrl+y", "command": "-edit.redo"},
  {"keys": "alt+left", "command": "-org.headline.promote"},
  {"keys": "alt+right", "command": "-org.headline.demote"},
  {"keys": "alt+shift+left", "command": "-org.headline.promoteSubtree"},
  {"keys": "alt+shift+right", "command": "-org.headline.demoteSubtree"},
  {"keys": "alt+up", "command": "-org.headline.moveSubtreeUp"},
  {"keys": "alt+down", "command": "-org.headline.moveSubtreeDown"},
  {"keys": "shift+right", "command": "-org.todo.next"},
  {"keys": "shift+left", "command": "-org.todo.previous"},
  {"keys": "shift+up", "command": "-org.priority.up"},
  {"keys": "shift+down", "command": "-org.priority.down"},
  {"keys": "tab", "command": "-list.indent"},
  {"keys": "shift+tab", "command": "-list.outdent"},
  {"keys": "alt+shift+right", "command": "-list.indentTree"},
  {"keys": "alt+shift+left", "command": "-list.outdentTree"},
  {"keys": "alt+up", "command": "-list.moveUp"},
  {"keys": "alt+down", "command": "-list.moveDown"},
  {"keys": "alt+enter", "command": "-list.insertItem"},
  {"keys": "alt+shift+down", "command": "-table.insertRow"},
  {"keys": "alt+shift+up", "command": "-table.killRow"},
  {"keys": "alt+up", "command": "-table.moveRowUp"},
  {"keys": "alt+down", "command": "-table.moveRowDown"},
  {"keys": "alt+shift+right", "command": "-table.insertColumn"},
  {"keys": "alt+shift+left", "command": "-table.deleteColumn"},
  {"keys": "alt+left", "command": "-table.moveColumnLeft"},
  {"keys": "alt+right", "command": "-table.moveColumnRight"},
  {"keys": "tab", "command": "-table.nextField"},
  {"keys": "shift+tab", "command": "-table.previousField"},
  {"keys": "enter", "command": "-table.nextRow"},
  {"keys": "tab", "command": "-view.fold"},
  {"keys": "shift+tab", "command": "-view.foldAll"},
  {"keys": "enter", "command": "-edit.newline"},
  { "keys": "C-x C-s", "command": "app.save" },
  { "keys": "C-x C-w", "command": "app.saveAs" },
  { "keys": "C-x C-c", "command": "app.quit" },
  { "keys": "C-x C-f", "command": "file.open" },
  { "keys": "C-x C-r", "command": "file.recent" },
  { "keys": "C-x k", "command": "file.close" },
  { "keys": "C-x b", "command": "file.switch" },
  { "keys": "C-x C-b", "command": "file.switch" },
  { "keys": "C-x <right>", "command": "file.next" },
  { "keys": "C-x <left>", "command": "file.previous" },
  { "keys": "C-x p p", "command": "project.switch" },
  { "keys": "C-x p f", "command": "project.findFile" },
  { "keys": "C-x p g", "command": "project.search" },
  { "keys": "C-x p b", "command": "project.switchDocument" },
  { "keys": "C-x p k", "command": "project.closeDocuments" },
  { "keys": "M-w", "command": "edit.copy" },
  { "keys": "C-w", "command": "edit.cut" },
  { "keys": "C-y", "command": "edit.paste" },
  { "keys": "C-x h", "command": "edit.selectAll" },
  { "keys": "C-x 3", "command": "view.split" },
  { "keys": "C-s", "command": "find.open" },
  { "keys": "M-%", "command": "find.replace" },
  { "keys": "M-x", "command": "view.palette" },
  { "keys": "C-c C-j", "command": "view.outline" },
  { "keys": "TAB", "command": "view.fold" },
  { "keys": "S-TAB", "command": "view.foldAll" },
  { "keys": "RET", "command": "edit.newline" },
  { "keys": "C-j", "command": "edit.newline" },
  { "keys": "C-/", "command": "edit.undo" },
  { "keys": "C-_", "command": "edit.undo" },
  { "keys": "C-x u", "command": "edit.undo" },
  { "keys": "C-?", "command": "edit.redo" },
  { "keys": "C-M-_", "command": "edit.redo" },
  { "keys": "M-<left>", "command": "org.headline.promote" },
  { "keys": "M-<right>", "command": "org.headline.demote" },
  { "keys": "M-S-<left>", "command": "org.headline.promoteSubtree", "when": "onHeadline" },
  { "keys": "M-S-<right>", "command": "org.headline.demoteSubtree", "when": "onHeadline" },
  { "keys": "M-<up>", "command": "org.headline.moveSubtreeUp" },
  { "keys": "M-<down>", "command": "org.headline.moveSubtreeDown" },
  { "keys": "C-c C-x C-w", "command": "org.headline.cutSubtree" },
  { "keys": "C-c C-x M-w", "command": "org.headline.copySubtree" },
  { "keys": "C-c C-x C-y", "command": "org.headline.pasteSubtree" },
  { "keys": "C-c ^", "command": "org.headline.sort", "when": "!inTable" },
  { "keys": "C-c ^", "command": "table.sortRows", "when": "inTable" },
  { "keys": "C-c C-t", "command": "org.todo.cycle" },
  { "keys": "S-<right>", "command": "org.todo.next" },
  { "keys": "S-<left>", "command": "org.todo.previous" },
  { "keys": "C-S-<right>", "command": "org.todo.nextSet", "when": "onHeadline" },
  { "keys": "C-S-<left>", "command": "org.todo.previousSet", "when": "onHeadline" },
  { "keys": "S-<up>", "command": "org.priority.up" },
  { "keys": "S-<down>", "command": "org.priority.down" },
  { "keys": "C-c ,", "command": "org.priority.set" },
  { "keys": "C-c C-x p", "command": "org.property.set" },
  { "keys": "C-c C-q", "command": "org.tags.set", "when": "onHeadline" },
  { "keys": "M-<left>", "command": "list.outdent" },
  { "keys": "M-<right>", "command": "list.indent" },
  { "keys": "M-S-<left>", "command": "list.outdentTree" },
  { "keys": "M-S-<right>", "command": "list.indentTree" },
  { "keys": "M-<up>", "command": "list.moveUp" },
  { "keys": "M-<down>", "command": "list.moveDown" },
  { "keys": "M-RET", "command": "list.insertItem" },
  { "keys": "M-S-RET", "command": "list.insertItem", "args": { "checkbox": true } },
  { "keys": "C-c C-c", "command": "list.toggleCheckbox", "when": "inList" },
  { "keys": "C-c C-x C-b", "command": "list.toggleCheckbox" },
  { "keys": "C-c -", "command": "list.cycleBullet" },
  { "keys": "C-c C-l", "command": "org.insert.link" },
  { "keys": "C-c C-o", "command": "org.link.open" },
  { "keys": "C-c C-,", "command": "org.insert.block" },
  { "keys": "C-c .", "command": "org.insert.date" },
  { "keys": "C-c !", "command": "org.insert.date", "args": { "inactive": true } },
  { "keys": "C-x n s", "command": "view.narrowToSubtree" },
  { "keys": "C-x n e", "command": "view.narrowToElement" },
  { "keys": "C-x n b", "command": "view.narrowToBlock" },
  { "keys": "C-x n w", "command": "view.widen" },
  { "keys": "C-c |", "command": "table.create", "when": "!inTable" },
  { "keys": "C-c C-c", "command": "table.align" },
  { "keys": "C-c *", "command": "table.recalculate" },
  { "keys": "C-c =", "command": "table.setFormula" },
  { "keys": "TAB", "command": "table.nextField" },
  { "keys": "S-TAB", "command": "table.previousField" },
  { "keys": "RET", "command": "table.nextRow" },
  { "keys": "M-<up>", "command": "table.moveRowUp" },
  { "keys": "M-<down>", "command": "table.moveRowDown" },
  { "keys": "M-<left>", "command": "table.moveColumnLeft" },
  { "keys": "M-<right>", "command": "table.moveColumnRight" },
  { "keys": "M-S-<left>", "command": "table.deleteColumn" },
  { "keys": "M-S-<right>", "command": "table.insertColumn" },
  { "keys": "M-S-<up>", "command": "table.killRow" },
  { "keys": "M-S-<down>", "command": "table.insertRow" },
  { "keys": "C-c -", "command": "table.insertHline" }
]
