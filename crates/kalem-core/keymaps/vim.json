// The Vim profile's own bindings, on top of the Word-like ones: Doom
// Emacs's leader keys (design §7.3). `leader` is the key of the setting
// `editor.vim.leader`, Space unless changed. They apply in normal and
// visual mode (`vimCommand`); a user keymap can add, change or remove them
// like any binding.
[
  { "keys": "leader :", "command": "view.palette", "when": "vimCommand" },
  { "keys": "leader space", "command": "project.findFile", "when": "vimCommand" },
  { "keys": "leader .", "command": "file.open", "args": { "prompt": true }, "when": "vimCommand" },
  { "keys": "leader ,", "command": "file.switch", "when": "vimCommand" },
  { "keys": "leader /", "command": "project.search", "when": "vimCommand" },
  // Buffers: the open documents.
  { "keys": "leader b b", "command": "file.switch", "when": "vimCommand" },
  { "keys": "leader b k", "command": "file.close", "when": "vimCommand" },
  { "keys": "leader b d", "command": "file.close", "when": "vimCommand" },
  { "keys": "leader b n", "command": "file.next", "when": "vimCommand" },
  { "keys": "leader b ]", "command": "file.next", "when": "vimCommand" },
  { "keys": "leader b p", "command": "file.previous", "when": "vimCommand" },
  { "keys": "leader b [", "command": "file.previous", "when": "vimCommand" },
  { "keys": "leader b s", "command": "app.save", "when": "vimCommand" },
  { "keys": "leader b r", "command": "app.revert", "when": "vimCommand" },
  { "keys": "leader b shift+n", "command": "file.new", "when": "vimCommand" },
  { "keys": "leader b shift+s", "command": "file.saveAll", "when": "vimCommand" },
  { "keys": "leader b l", "command": "file.last", "when": "vimCommand" },
  { "keys": "leader `", "command": "file.last", "when": "vimCommand" },
  { "keys": "leader b i", "command": "view.openFiles", "when": "vimCommand" },
  { "keys": "leader b x", "command": "file.scratch", "when": "vimCommand" },
  { "keys": "leader x", "command": "file.scratch", "when": "vimCommand" },
  { "keys": "leader b shift+x", "command": "file.scratch", "when": "vimCommand" },
  { "keys": "leader b shift+o", "command": "file.closeOthers", "when": "vimCommand" },
  { "keys": "leader b shift+k", "command": "file.closeAll", "when": "vimCommand" },
  { "keys": "leader b y", "command": "file.copyText", "when": "vimCommand" },
  { "keys": "leader b c", "command": "view.split", "when": "vimCommand" },
  { "keys": "leader b shift+c", "command": "view.split", "when": "vimCommand" },
  { "keys": "leader b shift+i", "command": "view.openFiles", "when": "vimCommand" },
  // Doom's `doom/toggle-narrow-buffer`: widen, else narrow.
  { "keys": "leader b -", "command": "view.widen", "when": "vimCommand && narrowed" },
  { "keys": "leader b -", "command": "view.narrowToElement", "when": "vimCommand && !narrowed && editorMode == org" },
  { "keys": "leader b z", "command": "file.bury", "when": "vimCommand" },
  { "keys": "leader b shift+b", "command": "file.switch", "when": "vimCommand" },
  { "keys": "leader <", "command": "file.switch", "when": "vimCommand" },
  // Files.
  { "keys": "leader f f", "command": "file.open", "args": { "prompt": true }, "when": "vimCommand" },
  { "keys": "leader f r", "command": "file.recent", "when": "vimCommand" },
  { "keys": "leader f s", "command": "app.save", "when": "vimCommand" },
  { "keys": "leader f shift+s", "command": "app.saveAs", "when": "vimCommand" },
  { "keys": "leader f shift+d", "command": "file.delete", "when": "vimCommand" },
  { "keys": "leader f shift+r", "command": "file.rename", "when": "vimCommand" },
  { "keys": "leader f shift+c", "command": "file.copy", "when": "vimCommand" },
  { "keys": "leader f y", "command": "file.copyPath", "when": "vimCommand" },
  { "keys": "leader f shift+y", "command": "file.copyRelativePath", "when": "vimCommand" },
  { "keys": "leader f d", "command": "file.open", "args": { "prompt": true }, "when": "vimCommand" },
  { "keys": "leader f shift+f", "command": "file.open", "args": { "prompt": true }, "when": "vimCommand" },
  { "keys": "leader f p", "command": "file.openSettingsFolder", "when": "vimCommand" },
  { "keys": "leader f shift+p", "command": "file.openKeymap", "when": "vimCommand" },
  { "keys": "leader f c", "command": "file.openWorkspaceSettings", "when": "vimCommand" },
  // Projects (Projectile).
  { "keys": "leader p p", "command": "project.switch", "when": "vimCommand" },
  { "keys": "leader p f", "command": "project.findFile", "when": "vimCommand" },
  { "keys": "leader p a", "command": "project.add", "when": "vimCommand" },
  { "keys": "leader p d", "command": "project.remove", "when": "vimCommand" },
  { "keys": "leader p r", "command": "project.recentFiles", "when": "vimCommand" },
  { "keys": "leader p b", "command": "project.switchDocument", "when": "vimCommand" },
  { "keys": "leader p k", "command": "project.closeDocuments", "when": "vimCommand" },
  { "keys": "leader p s", "command": "project.saveDocuments", "when": "vimCommand" },
  { "keys": "leader p i", "command": "project.refresh", "when": "vimCommand" },
  { "keys": "leader p .", "command": "dired.projectRoot", "when": "vimCommand" },
  { "keys": "leader p >", "command": "project.browseOther", "when": "vimCommand" },
  { "keys": "leader p !", "command": "project.shellCommand", "when": "vimCommand" },
  { "keys": "leader p e", "command": "file.openWorkspaceSettings", "when": "vimCommand" },
  { "keys": "leader p g", "command": "file.openWorkspaceSettings", "when": "vimCommand" },
  { "keys": "leader p o", "command": "file.other", "when": "vimCommand" },
  { "keys": "leader p t", "command": "project.todos", "when": "vimCommand" },
  { "keys": "leader p x", "command": "file.scratch", "args": { "project": true }, "when": "vimCommand" },
  { "keys": "leader p shift+x", "command": "file.scratch", "args": { "project": true }, "when": "vimCommand" },
  { "keys": "leader p &", "command": "project.shellCommand", "when": "vimCommand" },
  { "keys": "leader p shift+f", "command": "project.findFileOther", "when": "vimCommand" },
  { "keys": "leader p shift+p", "command": "dired.projects", "when": "vimCommand" },
  // Search.
  { "keys": "leader s p", "command": "project.search", "when": "vimCommand" },
  { "keys": "leader s s", "command": "search.lines", "when": "vimCommand" },
  { "keys": "leader s b", "command": "search.lines", "when": "vimCommand" },
  { "keys": "leader s shift+b", "command": "search.lines", "args": { "all": true }, "when": "vimCommand" },
  { "keys": "leader s i", "command": "search.lines", "args": { "headings": true }, "when": "vimCommand" },
  { "keys": "leader s shift+i", "command": "search.lines", "args": { "headings": true, "all": true }, "when": "vimCommand" },
  { "keys": "leader s shift+s", "command": "search.lines", "args": { "word": true }, "when": "vimCommand" },
  { "keys": "leader s d", "command": "search.folder", "when": "vimCommand" },
  { "keys": "leader s shift+d", "command": "search.folder", "args": { "ask": true }, "when": "vimCommand" },
  { "keys": "leader s shift+p", "command": "project.searchOther", "when": "vimCommand" },
  { "keys": "leader s o", "command": "search.online", "when": "vimCommand" },
  { "keys": "leader s shift+o", "command": "search.online", "when": "vimCommand" },
  // Open, toggle, windows, quit. `o p` and `o P` are the sidebar with the
  // folder tree (Doom's Treemacs); `o o`, `o O`, `o i` and `o I` those of
  // Doom's `:os macos`.
  { "keys": "leader o p", "command": "view.openFiles", "when": "vimCommand" },
  { "keys": "leader o o", "command": "file.reveal", "when": "vimCommand" },
  { "keys": "leader o shift+o", "command": "file.reveal", "args": { "project": true }, "when": "vimCommand" },
  { "keys": "leader o i", "command": "app.terminal", "when": "vimCommand" },
  { "keys": "leader o shift+i", "command": "app.terminal", "when": "vimCommand" },
  { "keys": "leader o t", "command": "app.terminal", "when": "vimCommand" },
  { "keys": "leader o shift+t", "command": "app.terminal", "args": { "project": true }, "when": "vimCommand" },
  { "keys": "leader o b", "command": "export.htmlBrowser", "when": "vimCommand" },
  { "keys": "leader o l", "command": "org.link.open", "when": "vimCommand" },
  { "keys": "leader *", "command": "project.searchWord", "when": "vimCommand" },
  { "keys": "leader '", "command": "picker.resume", "when": "vimCommand" },
  { "keys": "leader ~", "command": "view.toggleLastPanel", "when": "vimCommand" },
  { "keys": "leader u", "command": "app.universalArgument", "when": "vimCommand" },
  { "keys": "leader q s", "command": "session.save", "when": "vimCommand" },
  { "keys": "leader q shift+s", "command": "session.saveAs", "when": "vimCommand" },
  { "keys": "leader q l", "command": "session.restore", "when": "vimCommand" },
  { "keys": "leader q shift+l", "command": "session.restoreNamed", "when": "vimCommand" },
  { "keys": "leader q shift+k", "command": "session.saveAndQuit", "when": "vimCommand" },
  { "keys": "leader q shift+q", "command": "app.quitWithoutSaving", "when": "vimCommand" },
  { "keys": "leader q f", "command": "window.close", "when": "vimCommand" },
  { "keys": "leader q shift+f", "command": "file.closeAll", "when": "vimCommand" },
  { "keys": "leader q r", "command": "app.restartAndRestore", "when": "vimCommand" },
  { "keys": "leader q shift+r", "command": "app.restart", "when": "vimCommand" },
  { "keys": "leader enter", "command": "bookmark.jump", "when": "vimCommand" },
  { "keys": "leader n l", "command": "link.store", "when": "vimCommand" },
  { "keys": "leader n s", "command": "notes.search", "when": "vimCommand" },
  { "keys": "leader n shift+f", "command": "notes.browse", "when": "vimCommand" },
  { "keys": "leader n y", "command": "edit.copyHtml", "when": "vimCommand" },
  { "keys": "leader n shift+y", "command": "edit.copyRichText", "when": "vimCommand" },
  { "keys": "leader i e", "command": "insert.emoji", "when": "vimCommand" },
  { "keys": "leader i f", "command": "insert.fileName", "when": "vimCommand" },
  { "keys": "leader i shift+f", "command": "insert.filePath", "when": "vimCommand" },
  { "keys": "leader i r", "command": "insert.fromRegister", "when": "vimCommand" },
  { "keys": "leader i u", "command": "insert.unicode", "when": "vimCommand" },
  { "keys": "leader i y", "command": "insert.fromHistory", "when": "vimCommand" },
  // Workspaces (T2.7i.15).
  { "keys": "leader tab tab", "command": "workspace.list", "when": "vimCommand" },
  { "keys": "leader tab n", "command": "workspace.new", "when": "vimCommand" },
  { "keys": "leader tab shift+n", "command": "workspace.newNamed", "when": "vimCommand" },
  { "keys": "leader tab d", "command": "workspace.delete", "when": "vimCommand" },
  { "keys": "leader tab r", "command": "workspace.rename", "when": "vimCommand" },
  { "keys": "leader tab [", "command": "workspace.previous", "when": "vimCommand" },
  { "keys": "leader tab ]", "command": "workspace.next", "when": "vimCommand" },
  { "keys": "leader tab 1", "command": "workspace.switch", "args": { "index": 0 }, "when": "vimCommand" },
  { "keys": "leader tab `", "command": "workspace.last", "when": "vimCommand" },
  { "keys": "leader tab s", "command": "workspace.save", "when": "vimCommand" },
  { "keys": "leader tab l", "command": "workspace.load", "when": "vimCommand" },
  { "keys": "leader tab .", "command": "workspace.list", "when": "vimCommand" },
  { "keys": "leader tab shift+d", "command": "workspace.deleteSaved", "when": "vimCommand" },
  { "keys": "leader tab shift+r", "command": "session.restore", "when": "vimCommand" },
  { "keys": "leader tab 0", "command": "workspace.switch", "args": { "index": -1 }, "when": "vimCommand" },
  { "keys": "leader tab 2", "command": "workspace.switch", "args": { "index": 1 }, "when": "vimCommand" },
  { "keys": "leader tab 3", "command": "workspace.switch", "args": { "index": 2 }, "when": "vimCommand" },
  { "keys": "leader tab 4", "command": "workspace.switch", "args": { "index": 3 }, "when": "vimCommand" },
  { "keys": "leader tab 5", "command": "workspace.switch", "args": { "index": 4 }, "when": "vimCommand" },
  { "keys": "leader tab 6", "command": "workspace.switch", "args": { "index": 5 }, "when": "vimCommand" },
  { "keys": "leader tab 7", "command": "workspace.switch", "args": { "index": 6 }, "when": "vimCommand" },
  { "keys": "leader tab 8", "command": "workspace.switch", "args": { "index": 7 }, "when": "vimCommand" },
  { "keys": "leader tab 9", "command": "workspace.switch", "args": { "index": 8 }, "when": "vimCommand" },
  // Panes (T2.7i.5).
  { "keys": "leader w v", "command": "pane.splitRight", "when": "vimCommand" },
  { "keys": "leader w s", "command": "pane.splitBelow", "when": "vimCommand" },
  { "keys": "leader w h", "command": "pane.focus", "args": { "dir": "left" }, "when": "vimCommand" },
  { "keys": "leader w j", "command": "pane.focus", "args": { "dir": "down" }, "when": "vimCommand" },
  { "keys": "leader w k", "command": "pane.focus", "args": { "dir": "up" }, "when": "vimCommand" },
  { "keys": "leader w l", "command": "pane.focus", "args": { "dir": "right" }, "when": "vimCommand" },
  { "keys": "leader w shift+h", "command": "pane.move", "args": { "dir": "left" }, "when": "vimCommand" },
