  { "keys": "leader w c", "command": "pane.close", "when": "vimCommand" },
  { "keys": "leader w d", "command": "pane.close", "when": "vimCommand" },
  { "keys": "leader w o", "command": "pane.only", "when": "vimCommand" },
  { "keys": "leader w m m", "command": "pane.only", "when": "vimCommand" },
  { "keys": "leader w w", "command": "pane.next", "when": "vimCommand" },
  { "keys": "leader w p", "command": "pane.previous", "when": "vimCommand" },
