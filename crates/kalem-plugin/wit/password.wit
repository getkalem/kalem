package kalem:plugin@0.2.3;

/// Files protected by a password (a PDF with a user password): `open`
/// answers the error "This file is protected by a password", the host
/// asks the user, and opens the file with what they typed.
interface password {
    use files.{file};
    use viewer.{document};

    /// Opens `file` with `password`; the same error for a wrong one.
    open-with-password: func(file: file, password: string) -> result<document, string>;
}
