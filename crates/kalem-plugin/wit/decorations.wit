package kalem:plugin@0.2.8;

/// Marks beside the lines of files (API 0.2.5; T3.1.9c's first part): the
/// git plugin's added, changed and removed lines. A plugin sets a file's
/// marks whole, as the file is on disk; the editor moves them with the
/// edits made since, until the plugin sets them again. The editors draw
/// them in the gutter, and `edit.nextChange` and `edit.previousChange`
/// (Doom's `SPC g ]` and `SPC g [`) go from one change to the next.
interface decorations {
    /// What a line changed.
    enum mark-kind {
        /// The line is new.
        added,
        /// The line changed.
        changed,
        /// Lines were removed after it (after line 0: before the first).
        removed,
    }

    /// A line's mark.
    record line-mark {
        /// The line, from 1 (0 for lines removed before the first).
        line: u32,
        /// What changed there.
        kind: mark-kind,
    }

    /// Marks the lines of the file at `path` (absolute), in place of the
    /// plugin's earlier marks there; none takes them away. At most 10,000.
    set-gutter: func(path: string, marks: list<line-mark>) -> result<_, string>;

    /// Takes the plugin's marks away from the file at `path`, or from
    /// every file.
    clear-gutter: func(path: option<string>);
}
