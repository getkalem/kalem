package kalem:plugin@0.2.21;

/// Layers whose lines under a line are typed into as an outline (API
/// 0.2.18; `kalem_core::row_edit`): what `layer-3` gives, and with a
/// line's source the block of its file's outline that the line starts, so
/// that Enter, Tab and Shift+Tab where the line is typed into change the
/// file as its outline would. Enter splits the block at the cursor into a
/// new block where the layer says, Tab indents the block with the blocks
/// under it, Shift+Tab takes a step of indentation off them; each is written
/// as `layer-3`'s text is, and the block is typed into on at its new place
/// once the layer shows it. An embedded block's children added and moved
/// in the note embedding it, a query's tasks filed under one another. A
/// plugin exporting `layer-4` is asked by it, not by `layer-3`.
interface layer-4 {
    use layer.{span, lines};
    use layer-2.{piece};

    /// The block of a file's outline a line starts.
    record outline {
        /// The line after the block's last, the blocks under it included
        /// (from 0): Tab and Shift+Tab move the lines from the block's to
        /// it.
        end: u32,
        /// The line Enter puts a new block at (from 0): `end` for a block
        /// after it, the line after the block's own for a first child.
        next: u32,
        /// What a new block's line starts with: the block's indentation
        /// and bullet (`\t- `).
        bullet: string,
        /// A step of indentation (`\t`, two spaces): put before each of
        /// the block's lines by Tab, taken off them by Shift+Tab.
        step: string,
        /// Whether Tab may indent the block (a block before it at its
        /// level).
        indent: bool,
        /// Whether Shift+Tab may take it out a step.
        outdent: bool,
    }

    /// The text of a file a line under a line shows, as `layer-3`'s
    /// source: in file `path`, line `line` (from 0) from byte `column` to
    /// its end, which held `text`; and the block of the file's outline the
    /// line starts, if any.
    record source {
        path: string,
        line: u32,
        column: u32,
        text: string,
        outline: option<outline>,
    }

    /// A line drawn under a line, as `layer-3`'s.
    record virtual-line {
        indent: u32,
        pieces: list<piece>,
        source: option<source>,
    }

    /// Lines drawn under the line holding byte `at`.
    record below {
        at: u64,
        lines: list<virtual-line>,
    }

    /// What a layer changes, as `layer-3`'s overlay set.
    record overlay-set {
        spans: list<span>,
        lines: list<lines>,
        below: list<below>,
    }

    /// The overlays of layer `layer` (an ID of the manifest's `layers`)
    /// for the document of file `path` (none for one not saved yet) with
    /// `text`, as `layer-3`'s `overlays` gives them.
    overlays: func(layer: string, path: option<string>, text: string) -> overlay-set;
}
