	Volume = {92},
	Year = {2005},
	Bdsk-Url-1 = {www.jstor.org/stable/20441211}}

@article{CN2004,
	Abstract = {{$[$}For likelihood-based inference involving distributions in which high-dimensional dependencies are present it may be useful to use approximate likelihoods based, for example, on the univariate or bivariate marginal distributions. The asymptotic properties of formal maximum likelihood estimators in such cases are outlined. In particular, applications in which only a single q ×1 vector of observations is observed are examined. Conditions under which consistent estimators of parameters result from the approximate likelihood using only pairwise joint distributions are studied. Some examples are analysed in detail.{$]$}},
	Author = {Cox, D. R. and Reid, N.},
