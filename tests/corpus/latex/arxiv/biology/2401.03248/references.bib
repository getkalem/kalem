  isbn = {9781611974492 1611974496},
  keywords = {},
  publisher = {SIAM},
  refid = {1063563917},
  timestamp = {2020-10-21T02:18:10.000+0200},
  title = {Dynamic Mode Decomposition : Data-Driven Modeling of Complex Systems},
