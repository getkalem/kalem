  \tr{\td{2} \td{1,2500} \td{1,5000} \td{0,2500}}
  \tr{\td{5} \td{1,4636} \td{1,8000} \td{0,3364}}
  \tr{\td{10} \td{1,5498} \td{1,9000} \td{0,3502}}
  \tr{\td{20} \td{1,5962} \td{1,9500} \td{0,3538}}
  \formulas{
