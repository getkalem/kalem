          "value": "apa"
        }
      ],
      "blocks": [
        {
          "blocks": [
            {
              "p": [
                "Bu notta ",
                {
                  "math": "\\sum_{k=1}^{n} 1/k^2"
                },
                " toplamı için basit bir üst sınır veriyoruz ve sınırın Euler'in klasik sonucuyla ilişkisini tartışıyoruz."
              ]
            }
          ],
          "cmd": "abstract"
        },
        {
          "cmd": "macros",
          "verbatim": "\\newcommand{\\R}{\\mathbb{R}}\n\\newcommand{\\N}{\\mathbb{N}}"
        }
      ],
      "cmd": "meta"
    },
    {
      "attrs": [
        {
          "id": "giris"
        }
      ],
      "blocks": [
        {
          "p": [
            "Giriş"
          ]
        }
      ],
      "cmd": "h1"
    },
    {
      "p": [
        "Harmonik toplamların karesi, analizde en çok çalışılan dizilerden biridir ",
        {
          "attrs": [
            {
              "value": "euler1740,apostol1976"
            }
          ],
          "cmd": "cite"
        },
        ". ",
        {
          "math": "n \\in \\N"
        },
        " için ",
        {
          "math": "H_n^{(2)} = \\sum_{k=1}^{n} \\frac{1}{k^2}"
        },
        " yazalım. Amacımız, her ",
        {
          "math": "n"
        },
        " için geçerli ve hesaplanması kolay bir üst sınır vermek. Sonuç, lisans düzeyinde bir alıştırma niteliğindedir."
      ]
    },
    {
      "attrs": [
        {
          "id": "sonuc"
        }
      ],
      "blocks": [
        {
          "p": [
            "Ana sonuç"
          ]
        }
      ],
      "cmd": "h1"
    },
    {
      "attrs": [
        {
          "id": "thm:sinir"
        },
        {
          "style": "theorem"
        },
        {
          "key": "title",
          "value": "Teleskopik üst sınır"
        }
      ],
      "blocks": [
        {
          "p": [
            "Her ",
            {
              "math": "n \\ge 1"
            },
            " için"
          ]
        },
        {
          "attrs": [
            {
              "id": "eq:sinir"
            }
          ],
          "cmd": "eq",
          "verbatim": "H_n^{(2)} \\le 2 - \\frac{1}{n}."
        }
      ],
      "cmd": "block"
    },
    {
      "attrs": [
        {
          "style": "proof"
        }
      ],
      "blocks": [
        {
          "p": [
            {
              "math": "k \\ge 2"
            },
            " için ",
            {
              "math": "\\frac{1}{k^2} \\le \\frac{1}{k(k-1)} = \\frac{1}{k-1} - \\frac{1}{k}"
            },
            " olduğundan toplam teleskopiktir:"
          ]
        },
        {
          "attrs": [
            {
              "id": "eq:teleskop"
            },
            {
              "key": "env",
              "value": "align"
            }
          ],
          "cmd": "eq",
          "verbatim": "H_n^{(2)} &\\le 1 + \\sum_{k=2}^{n} \\left( \\frac{1}{k-1} - \\frac{1}{k} \\right) \\\\\n&= 1 + 1 - \\frac{1}{n} = 2 - \\frac{1}{n}."
        },
        {
          "p": [
            "Bu, ",
            {
              "attrs": [
                {
                  "value": "eq:sinir"
                }
              ],
              "cmd": "ref"
            },
            " eşitsizliğini verir."
          ]
        }
      ],
      "cmd": "block"
    },
    {
      "p": [
        "Sınır keskin değildir: Euler'in ünlü sonucu ",
        {
          "attrs": [
            {
              "value": "euler1740"
            }
          ],
          "cmd": "cite"
        },
        " limiti verir,"
      ]
    },
    {
      "attrs": [
        {
          "id": "eq:euler"
        }
      ],
      "cmd": "eq",
      "verbatim": "\\lim_{n \\to \\infty} H_n^{(2)} = \\frac{\\pi^2}{6} \\approx 1{,}6449."
    },
