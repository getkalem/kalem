\table[#tbl:costs cols="l r r r" header=1 caption-position=top]{
  \tr{\th{Item} \th{Qty} \th{Price} \th{Total}}
  \tr{\td{Paper} \td{3} \td{4.50} \td{}}
  \tr{\td{Ink} \td{1} \td{12.00} \td{}}
  \tfoot{
    \tr{\td{Total} \td{} \td{} \td{}}
  }
  \formulas{
    D = B * C
    D@foot = SUM(D)
  }
  \caption{Costs}
}
