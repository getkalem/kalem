From 9f854603485a72b5fb17dd3a27d92679e92fe551 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 08:51:30 +0000
Subject: [PATCH] Keep list items and autocompleted table cells inside their
 parent

Two sourcepos fixes, each with a regression test:

- A list item finalised after its list (the line that closes the list
  doesn't fit in it, so add_child closes the list while its last item is
  still open) kept an end at column 0 of the following blank line, outside
  the list. Items now get the same zero-end-column fix as lists.

- Autocompleted (empty) cells were placed one column past the last parsed
  cell, which lies outside a row that has no closing pipe. They are now
  clamped to the row's last column.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UCbVuffhS8fGJynW4LGo9n
---
 src/parser/mod.rs   | 10 ++++++++++
 src/parser/table.rs | 10 +++++++---
 src/tests/core.rs   | 28 ++++++++++++++++++++++++++++
 src/tests/table.rs  | 32 ++++++++++++++++++++++++++++++++
 4 files changed, 77 insertions(+), 3 deletions(-)

diff --git a/src/parser/mod.rs b/src/parser/mod.rs
index 17c851f..7e3df6f 100644
--- a/src/parser/mod.rs
+++ b/src/parser/mod.rs
@@ -2227,6 +2227,16 @@ where
                 }
                 nl.tight = self.determine_list_tight(node);
             }
+            NodeValue::Item(..) => {
+                // An item is finalised after its list when the line that
+                // closes the list doesn't fit in it (`add_child` closes the
+                // list first), so the list's column-0 fix never reaches it.
+                if ast.sourcepos.end.column == 0 {
+                    ast.sourcepos.end = self
+                        .fix_zero_end_columns(node)
+                        .unwrap_or(ast.sourcepos.start);
+                }
+            }
             NodeValue::FootnoteDefinition(_) => {
                 if let Some(candidate_end) = self.fix_zero_end_columns(node) {
                     ast.sourcepos.end = candidate_end;
diff --git a/src/parser/table.rs b/src/parser/table.rs
index 808c57e..4fd4a70 100644
--- a/src/parser/table.rs
+++ b/src/parser/table.rs
@@ -190,11 +190,15 @@ fn try_opening_row<'a>(
         last_column = cell_ast.sourcepos.end.column;
     }
 
+    // Autocompleted (empty) cells start and end just after the last parsed
+    // cell, but never past the row: without a closing pipe there is nothing
+    // after it, so they sit on the row's last column.
+    let row_end = new_row.data().sourcepos.end.column;
+    let empty_column = min(last_column + 1, row_end);
     for _ in parsed_cells..alignments.len() {
-        let cell_node = parser.add_child(new_row, NodeValue::TableCell, last_column + 1);
-        // for autocompleted (empty) cells, set end column equal to start
+        let cell_node = parser.add_child(new_row, NodeValue::TableCell, empty_column);
         let cell_ast = &mut cell_node.data_mut();
-        cell_ast.sourcepos.end.column = last_column + 1;
+        cell_ast.sourcepos.end.column = empty_column;
     }
 
     let offset = line.len() - parser.offset - newlines_of(line);
diff --git a/src/tests/core.rs b/src/tests/core.rs
index 10e183b..b1f4cd6 100644
--- a/src/tests/core.rs
+++ b/src/tests/core.rs
@@ -868,6 +868,34 @@ fn listitem_sourcepos_multiline_2() {
     );
 }
 
+#[test]
+fn listitem_sourcepos_closed_after_list() {
+    // The HTML block closes the list before its last item; the item must
+    // still end on its own text, not at column 0 of the blank line.
+    assert_ast_match!(
+        [],
+        "- foo\n"
+        "- bar\n"
+        "\n"
+        "<!-- -->\n",
+        (document (1:1-4:8) [
+            (list (1:1-2:5) [
+                (item (1:1-1:5) [
+                    (paragraph (1:3-1:5) [
+                        (text (1:3-1:5) "foo")
+                    ])
+                ])
+                (item (2:1-2:5) [
+                    (paragraph (2:3-2:5) [
+                        (text (2:3-2:5) "bar")
+                    ])
+                ])
+            ])
+            (html_block (4:1-4:8) "<!-- -->\n")
+        ])
+    );
+}
+
 #[test]
 fn emphasis_sourcepos_double_1() {
     assert_ast_match!(
